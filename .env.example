# Copier en .env puis renseigner les valeurs réelles (ne jamais commiter .env).
# Toutes les variables sont validées au démarrage (src/server/env.ts) : une valeur manquante ou invalide arrête l'application.

# PostgreSQL local (service Windows postgresql-x64-18). La base est créée par la première migration si elle n'existe pas.
DATABASE_URL="postgresql://UTILISATEUR:MOT_DE_PASSE@localhost:5432/doztra_learn?schema=public"

# URL publique du site (contrôle d'origine des requêtes, liens absolus).
APP_URL="http://localhost:3000"

# "true" seulement derrière un reverse proxy de confiance (Nginx) : l'IP réelle est lue dans X-Forwarded-For.
TRUST_PROXY="false"

# Niveau des journaux : fatal, error, warn, info, debug, trace, silent.
LOG_LEVEL="info"
